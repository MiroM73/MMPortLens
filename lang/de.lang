cli.error.unknown = Unbekannte Option: {option}
cli.error.missing_value = Die Option {option} braucht einen Wert.
cli.error.unexpected_value = Die Option {option} nimmt keinen Wert.
cli.error.argument = Unerwartetes Argument: {value} (nur eine Aufzeichnungsdatei mit der Endung .plrec).
cli.error.lang = Unbekannte Sprache für --lang: "{value}". Verfügbar: {languages}
cli.error.interval = Ungültiges Intervall für --interval: "{value}" (eine ganze Zahl Millisekunden, {min} oder mehr).
cli.error.duration = Ungültige Dauer für --duration: "{value}" (10m, 90s, 1h30m oder eine Anzahl Minuten).
cli.error.column_syntax = Ungültiger Spaltenfilter für --column: "{value}" (SPALTE=FILTER, z. B. state==Established).
cli.error.column = Unbekannte Spalte für --column: "{value}". Spalten: {columns}
cli.error.column_regex = Ungültiger regulärer Ausdruck im Filter der Spalte {column}: {error}
cli.error.column_network = Ungültiges Netz "{value}" im Filter der Spalte {column}. Die Präfixlänge ist 0–32 für IPv4 und 0–128 für IPv6.
cli.error.preset = Unbekannte Filtervorlage für --preset: "{name}"
cli.error.needs = Die Option {option} braucht {needs}.
cli.error.conflict = Die Optionen {option} und {other} können nicht zusammen verwendet werden.
cli.error.export_format = Unbekanntes Exportformat von {file} – verwende .csv, .xlsx, .jsonl oder .html.
cli.error.hint = mmportlens --help listet die Optionen auf.
cli.record.started = Aufzeichnung nach {path} – Strg+C beendet sie.
cli.record.started_for = Aufzeichnung nach {path} für {duration} – Strg+C beendet sie früher.
cli.record.cancelled = Die Aufzeichnung wurde abgebrochen, bevor sie begann.
